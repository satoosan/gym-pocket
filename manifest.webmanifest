{
  "name": "Gym Pocket",
  "short_name": "Gym Pocket",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0b0d10",
  "theme_color": "#0b0d10",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./?open-gympocket=1",
      "accept": {
        "application/x-gym-pocket": [
          ".gympocket"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "backup",
          "accept": [
            "application/x-gym-pocket",
            "application/json",
            "text/plain",
            ".gympocket",
            ".json"
          ]
        }
      ]
    }
  }
}